# Crypto.com Exchange API
# Create the first key as read-only. Do not enable withdrawals.
CCOM_API_KEY=
CCOM_API_SECRET=

# production or uat
CCOM_ENV=production

# Bot mode
# Keep both values like this until you are happy with dry-run logs.
DRY_RUN=true
ENABLE_TRADING=false

# Market
INSTRUMENT=BTC_USD
BASE_ASSET=BTC
QUOTE_ASSET=USD

# Up/down strategy
# If price drops by this percent versus the previous logged snapshot, propose/buy.
BUY_DROP_PCT=3

# If price rises by this percent versus the previous logged snapshot, propose/sell.
SELL_RISE_PCT=4

# Maximum quote currency amount per proposed trade.
TRADE_NOTIONAL=25

# Scheduler for `npm run watch`.
CHECK_INTERVAL_MINUTES=60
