# Crypto.com Exchange API
# Create the first key as read-only. Do not enable withdrawals.
CCOM_API_KEY=
CCOM_API_SECRET=

# production or uat
CCOM_ENV=production

# Bot mode
# Keep both values like this until you are happy with dry-run logs.
DRY_RUN=true
ENABLE_TRADING=false

# Market
INSTRUMENT=CRO_USD
BASE_ASSET=CRO
QUOTE_ASSET=USD

# Strategy: updown or batches
STRATEGY=batches

# Up/down strategy
# If price drops by this percent versus the previous logged snapshot, propose/buy.
BUY_DROP_PCT=3

# If price rises by this percent versus the previous logged snapshot, propose/sell.
SELL_RISE_PCT=4

# Maximum quote currency amount per proposed trade.
TRADE_NOTIONAL=25

# Batch strategy
BATCH_QUANTITY=20
MAX_BATCH_QUANTITY=500
AVERAGE_DOWN_DROP_PCT=10
TAKE_PROFIT_RISE_PCT=5
BUY_BASE_BATCH_EVERY_RUN=true
BASE_BUY_COOLDOWN_MINUTES=60
DUST_SELL_QUANTITY=20

# Scheduler for `npm run watch`.
CHECK_INTERVAL_MINUTES=10
