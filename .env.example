# Crypto.com Exchange API
# Optional: run with ENV_FILE=.env.cro-usd or ENV_FILE=.env.btc-usd for separate bots.
# Create the first key as read-only. Do not enable withdrawals.
CCOM_API_KEY=
CCOM_API_SECRET=

# production or uat
CCOM_ENV=production

# Bot mode
# Keep both values like this until you are happy with dry-run logs.
DRY_RUN=true
ENABLE_TRADING=false

# Market
INSTRUMENT=CRO_USD
BASE_ASSET=CRO
QUOTE_ASSET=USD
LOG_DIR=logs/cro-usd

# Strategy: updown or batches
STRATEGY=batches

# Order mode: market or maker
# maker uses LIMIT orders from the public order book instead of MARKET orders.
ORDER_MODE=market
MAKER_BOOK_LEVEL=3
MAKER_MAX_SPREAD_PCT=0
MAKER_POST_ONLY_MODE=SMART_POST_ONLY
# 0 disables automatic cancellation. Positive values cancel stale maker orders so the next run can place a fresh one.
MAKER_ORDER_TIMEOUT_MINUTES=0
MAKER_REPRICE_AFTER_MINUTES=0

# Up/down strategy
BUY_DROP_PCT=3
SELL_RISE_PCT=4
TRADE_NOTIONAL=25

# Batch strategy
BATCH_QUANTITY=20
MAX_BATCH_QUANTITY=500
# 0 means unlimited. Example: 30 stops new base buys once 30 batches are open.
MAX_OPEN_BATCHES=0
# 0 means unlimited. Example: 6 allows at most 6 new base batches per UTC day.
DAILY_BASE_BUY_LIMIT=0
# 0 means disabled. Example: 1 forces at least 1 base batch per UTC week.
FORCE_BASE_BUY_WEEKLY_LIMIT=0
# 0 means disabled. Example: 25 keeps at least 25 USD available by skipping BUY actions.
MIN_QUOTE_BALANCE=0
# 0 means disabled. Example: 25 halts the run if price moves over 25% since the previous snapshot.
MAX_SUSPICIOUS_PRICE_MOVE_PCT=25
AVERAGE_DOWN_DROP_PCT=10
TAKE_PROFIT_RISE_PCT=5
BUY_BASE_BATCH_EVERY_RUN=true
BASE_BUY_COOLDOWN_MINUTES=60
DUST_SELL_QUANTITY=20

# Scheduler for `npm run watch`.
CHECK_INTERVAL_MINUTES=10
