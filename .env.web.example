# Local/private web dashboard settings.
# Copy to .env.web on the VPS or local machine and choose a strong password.

WEB_BIND_HOST=127.0.0.1
WEB_PORT=8787
WEB_USERNAME=admin
WEB_PASSWORD=change-this-password

# Optional: comma-separated env files. Default is .env.cro-usd,.env.btc-usd when they exist.
# WEB_ENV_FILES=.env.cro-usd,.env.btc-usd

# Optional: sqlite, logs, or auto. auto tries SQLite first and falls back to log files.
WEB_DATA_SOURCE=auto

# Optional: separate cookie signing secret. If omitted, WEB_PASSWORD is used.
# WEB_SESSION_SECRET=change-this-long-random-secret

# Optional: mark cookies Secure only when the dashboard is behind HTTPS.
# WEB_COOKIE_SECURE=false
